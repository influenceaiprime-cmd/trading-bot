# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Required: Binance API credentials (testnet keys from https://testnet.binance.vision
# while developing; only use real mainnet keys once you fully trust the strategy)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional: Discord webhook URL for trade alerts
DISCORD_WEBHOOK=

# Optional: Telegram bot alerts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
